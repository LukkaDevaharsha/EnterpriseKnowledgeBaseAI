APP_ENV=development
FLASK_DEBUG=true

# Comma-separated exact origins; leave blank for same-origin/no CORS. Production requires HTTPS origins.
CORS_ALLOWED_ORIGINS=

DB_USER=postgres
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_knowledge_base
# Optional PostgreSQL SSL mode, such as "require" for hosted databases. Leave blank for local defaults.
DB_SSLMODE=

# Generate and set a unique random key locally; production requires 32+ bytes.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30

# Optional: use a durable path for uploaded files. Defaults to ../storage/documents.
DOCUMENT_STORAGE_PATH=

# Use local storage for development, or supabase_s3 for private Supabase Storage.
STORAGE_BACKEND=local
# Supabase S3 endpoint defaults for this project. Keep the bucket private.
S3_ENDPOINT_URL=https://ixkkqeyzopkbdcfnzwye.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=enterprise-knowledge-base-docs
# Set credentials only in backend/.env or the deployment secret manager; never commit them.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set HF_HOME to a durable cache path in the process environment when deploying.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# Optional per-mode Ollama models; blank values inherit OLLAMA_MODEL.
GENERAL_AI_MODEL=llama3.2:3b
COMPANY_KNOWLEDGE_MODEL=llama3.2:3b
STUDY_PDF_MODEL=llama3.2:3b

RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=10
RAG_MAX_CONTEXT_CHARS=12000
RAG_MIN_SIMILARITY=0.25

# Gmail SMTP example: create an app password and configure it only in backend/.env.
# Delivery uses STARTTLS when SMTP_USE_TLS=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

