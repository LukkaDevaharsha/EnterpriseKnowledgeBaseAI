APP_ENV=development
FLASK_DEBUG=true

# Comma-separated exact origins; leave blank for same-origin/no CORS. Production requires HTTPS origins.
CORS_ALLOWED_ORIGINS=

DB_USER=postgres
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_knowledge_base
# Optional PostgreSQL SSL mode, such as "require" for hosted databases. Leave blank for local defaults.
DB_SSLMODE=

# Generate and set a unique random key locally; production requires 32+ bytes.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30

# Optional: use a durable path for uploaded files. Defaults to ../storage/documents.
DOCUMENT_STORAGE_PATH=

# Use local storage for development, or supabase_s3 for private Supabase Storage.
STORAGE_BACKEND=local
# Supabase S3 endpoint defaults for this project. Keep the bucket private.
S3_ENDPOINT_URL=https://ixkkqeyzopkbdcfnzwye.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=enterprise-knowledge-base-docs
# Set credentials only in backend/.env or the deployment secret manager; never commit them.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# LLM_PROVIDER selects ollama (local default) or gemini. Gemini credentials stay backend-only.
LLM_PROVIDER=ollama
GEMINI_API_KEY=
# Fallback Gemini model; mode-specific settings below can select separate models.
GEMINI_MODEL=gemini-3.8-flash
# Gemini SDK HTTP timeout in seconds (google-genai receives this as milliseconds).
GEMINI_TIMEOUT_SECONDS=120

# sentence_transformers remains the local default. Gemini uses 384 dimensions to match the DB schema.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# Optional per-mode model overrides. Use Ollama tags with LLM_PROVIDER=ollama or
# Gemini API model IDs with LLM_PROVIDER=gemini. Blank values inherit OLLAMA_MODEL or GEMINI_MODEL.
GENERAL_AI_MODEL=
COMPANY_KNOWLEDGE_MODEL=
STUDY_PDF_MODEL=

RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=10
RAG_MAX_CONTEXT_CHARS=12000
RAG_MIN_SIMILARITY=0.25

# Gmail SMTP example: create an app password and configure it only in backend/.env.
# Delivery uses STARTTLS when SMTP_USE_TLS=true.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Optional Resend HTTPS API delivery. Credentials and verified sender stay backend-only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TIMEOUT_SECONDS=10

# Optional Gmail API OAuth provider (send-only scope). Keep OAuth values in the backend secret store.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=webmanagerepm01@gmail.com
GMAIL_TIMEOUT_SECONDS=10

# Render build command from the project root: pip install -r backend/requirements-render.txt
# This cloud requirements file omits Sentence Transformers and PyTorch.

